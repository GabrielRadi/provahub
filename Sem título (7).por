programa {
  funcao inicio() {
    cadeia n1
    inteiro idade
    escreva ("Digite seu nome: ")
    leia (n1)
    escreva ("Digite a sua idade: ")
    leia (idade)
    se (idade > 18){
    	escreva (n1, ", você é maior de idade")
    }senao{
    	escreva (n1, ", você é menor de idade")
    		}
    }
}
